# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Supabase Server / Secret Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Web Push (VAPID) Keys (Generated via `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.com   # required for push; no fallback

# LeetCode Sync Cron Secret (Any random 32-byte hex string)
CRON_SECRET=your-random-cron-secret-hex

# Supabase Service Role Key (for server sync routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret key used to encrypt stored LeetCode session cookies (min 16 chars)
LEETCODE_SESSION_SECRET=your-random-session-secret-min-16-chars

# Canonical public origin — REQUIRED in production.
# Used for OG/sitemap/robots and the leetcode.com CORS allowlist.
# If unset, those fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Extra origins allowed to make cookie-authenticated state changes
# (comma-separated). Self-origin + https://leetcode.com are always allowed.
ALLOWED_ORIGINS=https://your-domain.vercel.app

# Deploy target for the GitHub Actions cron (.github/workflows/sync.yml).
# Set APP_URL as a repo variable (Settings → Variables → APP_URL) to
# your host only, e.g. mahayuddh.vercel.app — no scheme. Do NOT rely on
# a fallback in the workflow.
# APP_URL=mahayuddh.vercel.app

# AI (Sarathi). Off unless a key AND AI_BASE_URL AND AI_MODEL are all set;
# there are no endpoint or model defaults in code. One key, one of:
KILO_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
AI_BASE_URL=        # API root, e.g. https://ai-gateway.kilo.ai/api/v1 for Kilo
AI_MODEL=           # e.g. kilo-auto/free
# AI_PROVIDER=      # openai | anthropic | gemini | kilo; only when several keys are set
# AI_MAX_TOKENS=400 # answer budget; reasoning headroom is added on top
# AI_TIMEOUT_MS=    # default 20000, 45000 for kilo

# Who runs the site (Privacy Policy, Terms, account-deletion contact). Required:
# a missing one shows as "[NAME not set]" on those pages.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_HANDLE=        # e.g. github.com/you
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_JURISDICTION=           # e.g. India

# Dev only: show social sign-in buttons on /login without enabling the
# providers in Supabase ("all" or e.g. "github,google"). Ignored in production.
# AUTH_PROVIDERS_PREVIEW=all

# Error tracking (PostHog). Optional: off unless both are set. Errors only:
# no session recordings, no click tracking, no cookies.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=   # the project's public token, phc_...
NEXT_PUBLIC_POSTHOG_HOST=            # e.g. https://eu.i.posthog.com or https://us.i.posthog.com
