# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Supabase Server / Secret Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Web Push (VAPID) Keys (Generated via `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.com

# LeetCode Sync Cron Secret (Any random 32-byte hex string)
CRON_SECRET=your-random-cron-secret-hex

# Supabase Service Role Key (for server sync routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret key used to encrypt stored LeetCode session cookies (min 16 chars)
LEETCODE_SESSION_SECRET=your-random-session-secret-min-16-chars

# Canonical public origin — REQUIRED in production.
# Used for OG/sitemap/robots and the leetcode.com CORS allowlist.
# If unset, those fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Extra origins allowed to make cookie-authenticated state changes
# (comma-separated). Self-origin + https://leetcode.com are always allowed.
ALLOWED_ORIGINS=https://your-domain.vercel.app

# AI provider (optional — app runs without it, AI routes return no_provider).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=openai            # openai | anthropic (default: inferred from which key is set)
# AI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible gateways
# AI_MODEL=gpt-4o-mini          # default: gpt-4o-mini / claude-3-5-haiku-latest
# AI_TIMEOUT_MS=20000
# AI_MAX_TOKENS=400

# Deploy target for the GitHub Actions cron (.github/workflows/sync.yml).
# Set APP_URL as a repo variable (Settings → Variables → APP_URL) to
# your host only, e.g. mahayuddh.vercel.app — no scheme. Do NOT rely on
# a fallback in the workflow.
# APP_URL=mahayuddh.vercel.app
