# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/

# Production
/build

# Environment variables
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
*.pem
image*.png
*.screenshot.png
# `scripts/` is ignored because it holds local one-off tooling, but
# make-schema-idempotent.py is part of the documented schema regeneration
# procedure in README, so it has to be in the repo. sync-contests.mjs is
# imported by app/api/sync/contests/route.ts, so a fresh clone without it
# cannot build — which is the same class of problem, found the hard way. Git cannot re-include a
# file whose parent directory is excluded, hence scripts/* rather than scripts/.
scripts/*
!scripts/make-schema-idempotent.py
!scripts/sync-contests.mjs

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Reference source files (not ours)
sourcecode.*
sorucecode.*

# Stitch pulled frames (local only, regenerate via /tmp/pull_frames.py)
stitch_frames/
